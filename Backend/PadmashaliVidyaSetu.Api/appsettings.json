{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "PadmashaliVidyaSetu",
    "Audience": "PadmashaliVidyaSetu.Mobile",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "PhoneVerification": {
    "Sender": "NotConfigured",
    "ExposeCodeInResponse": false,
    "CodeLifetimeSeconds": 300,
    "ResendCooldownSeconds": 30,
    "MaxCodesPerHourPerNumber": 5,
    "MaxFailedAttemptsPerCode": 5
  },
  "Registration": {
    "MinimumAge": 5,
    "MaximumAge": 100,
    "MaxMembersPerAccount": 10,
    "GuardianConsentRequiredBelowAge": 18,
    "PrivacyPolicyVersion": "2026.10-draft"
  },
  "PinCodeLookup": {
    "BaseUrl": "https://api.postalpincode.in/",
    "TimeoutSeconds": 10
  },
  "RateLimiting": {
    "VerificationPermitLimit": 10,
    "VerificationWindowSeconds": 600,
    "AuthPermitLimit": 30,
    "LookupPermitLimit": 30,
    "GlobalPermitLimit": 300
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
