{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/pvs-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:iqexploresql.database.windows.net,1433;Initial Catalog=IQExploreDB_dev_02;Persist Security Info=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "PhoneVerification": {
    "Sender": "Development",
    "ExposeCodeInResponse": true,
    "ResendCooldownSeconds": 15
  },
  "RateLimiting": {
    "VerificationPermitLimit": 200
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5000", "http://localhost:8080", "http://localhost:4200" ],
    "AllowAnyLocalhostOrigin": true
  },
  "SMS": {
    "APIKey": "",
    "SMSURL": "https://www.smsgatewayhub.com/api/mt/SendSMS",
    "OTPSenderId": "VSETHU",
    "OTPTemplateId": "1177179234188678319",
    "OTPEntityId": "1101698060000095750",
    "OTPTemplate": "Your Phone Number Verification Code for Vidya Sethu is {#var#} Valid for 10 minutes -Vidya Sethu",
    "Route": "1",
    "Channel": "2",
    "TimeoutSeconds": 15
  }
}
