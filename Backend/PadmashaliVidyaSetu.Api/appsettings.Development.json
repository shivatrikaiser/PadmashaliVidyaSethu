{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/pvs-api-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14 }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=PadmashaliVidyaSetu;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "PhoneVerification": {
    "Sender": "Development",
    "ExposeCodeInResponse": true,
    "ResendCooldownSeconds": 15
  },
  "RateLimiting": {
    "VerificationPermitLimit": 200
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5000", "http://localhost:8080" ]
  }
}
