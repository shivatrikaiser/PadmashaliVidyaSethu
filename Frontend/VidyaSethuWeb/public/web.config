<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows / IIS) configuration for the VidyaSethu website.
  On Linux App Service this file is ignored and server.mjs does the same job.

  * www.vidyasethu.co.in -> https://vidyasethu.co.in (301), and "/about/" -> "/about" (301)
  * "/about" is served from about/index.html (every page is a prerendered file)
  * unknown addresses get /404/index.html with status 404 (no SPA fallback, so search engines see real 404s)
  * security headers; the CSP script hashes are filled in by scripts/postbuild.mjs at build time
  * hashed JS/CSS cached for a year
  * /pvs (and /pvs/...): the Padmashali Vidya Sethu web app moved to https://pvs.vidyasethu.co.in (301)
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Canonical host (www to apex)" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.vidyasethu\.co\.in$" />
          </conditions>
          <action type="Redirect" url="https://vidyasethu.co.in/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="PVS app moved to pvs.vidyasethu.co.in" stopProcessing="true">
          <match url="^pvs(/.*)?$" />
          <action type="Redirect" url="https://pvs.vidyasethu.co.in{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Remove trailing slash" stopProcessing="true">
          <match url="^(.+)/$" />
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Hide CSR shell" stopProcessing="true">
          <match url="^index\.csr\.html$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" />
        </rule>
        <rule name="Prerendered page" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Rewrite" url="{R:1}/index.html" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Cache hashed bundles">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/(main|chunk|styles|polyfills)-[A-Z0-9]+\.(js|css)$" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="Revalidate pages">
          <!-- Pages must not be cached stale: after a deployment they point to new bundle file names. -->
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </conditions>
          <action type="Rewrite" value="no-cache" />
        </rule>
        <rule name="Cache images">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/(brand|organizations)/.+\.(png|jpe?g|svg|webp)$" />
          </conditions>
          <action type="Rewrite" value="public, max-age=86400" />
        </rule>
      </outboundRules>
    </rewrite>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />

    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <!-- "File" keeps the 404 status ("ExecuteURL" would turn it into 200). Path is relative to the site root. -->
      <error statusCode="404" path="404\index.html" responseMode="File" />
    </httpErrors>

    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <security>
      <requestFiltering removeServerHeader="true">
        <!-- Deployment files that sit next to the site but must never be served. -->
        <hiddenSegments>
          <add segment="server.mjs" />
          <add segment="package.json" />
          <add segment="staticwebapp.config.json" />
          <add segment="prerendered-routes.json" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.pvs.vidyasethu.co.in; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
