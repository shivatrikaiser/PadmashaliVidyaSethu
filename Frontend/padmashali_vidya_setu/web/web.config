<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service (Windows / IIS) configuration for the PVS member web app (https://pvs.vidyasethu.co.in).
  Flutter copies this file into build/web; upload the contents of build/web to /site/wwwroot.

  * the app's own files as they are; every other address is one of its screens (index.html)
  * security headers; the CSP allows WebAssembly, the API and Google's font CDN (fallback glyphs)
  * assets / canvaskit / icons cached for a day; main.dart.js, flutter_bootstrap.js etc. keep their names between
    releases, so they are revalidated
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Hide Static Web Apps config" stopProcessing="true">
          <match url="^staticwebapp\.config\.json$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" />
        </rule>
        <rule name="Files" stopProcessing="true">
          <match url=".+" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>
        <rule name="Screens" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="Cache assets for a day">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/(assets|canvaskit|icons)/" />
          </conditions>
          <action type="Rewrite" value="public, max-age=86400" />
        </rule>
        <rule name="Revalidate the rest">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/(?!(assets|canvaskit|icons)/)" />
          </conditions>
          <action type="Rewrite" value="no-cache" />
        </rule>
      </outboundRules>
    </rewrite>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />

    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".bin" />
      <mimeMap fileExtension=".bin" mimeType="application/octet-stream" />
      <remove fileExtension=".frag" />
      <mimeMap fileExtension=".frag" mimeType="application/octet-stream" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/otf" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <!-- assets/NOTICES has no extension -->
      <remove fileExtension="." />
      <mimeMap fileExtension="." mimeType="text/plain" />
    </staticContent>

    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.pvs.vidyasethu.co.in; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.pvs.vidyasethu.co.in https://fonts.gstatic.com; worker-src 'self' blob:; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=(), usb=()" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
